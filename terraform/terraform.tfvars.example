# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
project_id = "my-gcp-project"
region     = "europe-west1"

environment  = "prod"
cluster_name = "mlops-gke"

# Training pool (spot by default to cut batch-training cost).
training_machine_type = "e2-standard-4"
training_min_nodes    = 0
training_max_nodes    = 4
use_spot_nodes        = true

artifact_registry_repo  = "mlops"
mlflow_artifacts_bucket = "mlflow-artifacts"

k8s_namespace       = "mlops"
k8s_service_account = "ml-api"
