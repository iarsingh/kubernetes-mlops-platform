# =============================================================================
# Example environment file. Copy to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real credentials.
# =============================================================================

# ---- MLflow tracking ------------------------------------------------------
# The tracking server URI. For local docker-compose this is the mlflow service.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=churn-classifier
# Register the trained model in the Model Registry (train.py).
MLFLOW_REGISTER_MODEL=true

# ---- Artifact store (MinIO / S3-compatible) -------------------------------
# MLflow uploads model artifacts here. In cloud, use GCS + Workload Identity
# instead of static keys (see terraform/ and SECURITY.md).
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts

# ---- MLflow metadata backend (PostgreSQL) ---------------------------------
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow
# Full SQLAlchemy URL MLflow uses as its backend store.
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:mlflow@postgres:5432/mlflow

# ---- Inference service ----------------------------------------------------
REGISTERED_MODEL_NAME=churn-classifier
PRODUCTION_ALIAS=champion
# If the registry is unreachable, fall back to a local model at LOCAL_MODEL_PATH.
ALLOW_LOCAL_FALLBACK=true
LOCAL_MODEL_PATH=./artifacts/model
LOG_LEVEL=INFO
